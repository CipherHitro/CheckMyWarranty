# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Exclude all .tfvars files
*.tfvars

# Include tfvars.example files if you want to commit them
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Key files
*.pem

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
