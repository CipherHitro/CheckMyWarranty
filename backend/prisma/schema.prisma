generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model documents {
  id                BigInt            @id @default(autoincrement())
  user_id           BigInt
  file_url          String
  original_filename String?
  expiry_date       DateTime?         @db.Date
  rag_status        String?           @default("pending") @db.VarChar(20)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")
  reminders         reminders[]
  document_chunks   document_chunks[]
}

model reminders {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  document_id BigInt
  remind_at   DateTime  @db.Timestamp(6)
  status      String?   @default("pending") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  documents   documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_reminder")
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_reminder")
}

model users {
  id              BigInt            @id @default(autoincrement())
  email           String            @unique @db.VarChar(255)
  password_hash   String
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  documents       documents[]
  reminders       reminders[]
}

model document_chunks {
  id          BigInt                      @id @default(autoincrement())
  user_id     BigInt
  document_id BigInt
  content     String
  embedding   Unsupported("vector(1024)")?
  created_at  DateTime?                   @default(now()) @db.Timestamp(6)
  documents   documents                   @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_chunk")

  @@index([document_id], map: "idx_document_chunks_document_id")
  @@index([user_id], map: "idx_document_chunks_user_id")
}
